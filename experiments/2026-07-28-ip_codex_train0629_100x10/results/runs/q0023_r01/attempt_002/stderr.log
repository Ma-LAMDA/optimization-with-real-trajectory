  $bl=@($b -split "\r?\n" | ForEach-Object {$_.TrimEnd()} | Where-Object {$_ -match $pat})
  $d=Compare-Object -ReferenceObject $bl -DifferenceObject $cl
  if($d) {
    Write-Output "===== $n ====="
    $d | ForEach-Object {"$($_.SideIndicator) $($_.InputObject)"}
  }
}
}'
